flowchart LR

    %% =========================
    %% ACTOR
    %% =========================

    User(("👤<br/><b>Pengguna</b>")):::actorDef


    %% =========================
    %% SYSTEM BOUNDARY
    %% =========================

    subgraph SystemBoundary ["📱 RITUN - Self-Discipline App"]
        direction TB

        %% DASHBOARD
        UC_Dash(["📊 Melihat Dashboard"]):::ucDash
        UC_XP(["⭐ Melihat XP & Streak"]):::ucDash
        UC_Prog(["📈 Melihat Progres Hafalan"]):::ucDash

        %% APPLICATION LOCK
        UC_Atur(["⚙️ Mengatur Aplikasi Terkunci"]):::ucLock
        UC_Buka(["🔓 Mengakses Aplikasi Terkunci"]):::ucLock

        %% RECITATION
        UC_Setor(["📖 Melakukan Setoran Hafalan"]):::ucRecite
        UC_Ayat(["🎲 Mendapatkan Ayat Acak Juz 30"]):::ucRecite
        UC_Rekam(["🎙️ Merekam Bacaan"]):::ucRecite
        UC_Eval(["🤖 Mengevaluasi Bacaan"]):::ucRecite
        UC_Ulang(["🔄 Mengulang Setoran"]):::ucRecite

        %% TIMER
        UC_Timer(["⏱️ Menggunakan Aplikasi<br/>dalam Batas Waktu"]):::ucLock
        UC_SetorLagi(["🔁 Melakukan Setoran<br/>untuk Akses Berikutnya"]):::ucRecite


        %% =========================
        %% INCLUDE / EXTEND
        %% =========================

        UC_Buka -.->|"<<include>>"| UC_Setor

        UC_Setor -.->|"<<include>>"| UC_Ayat
        UC_Setor -.->|"<<include>>"| UC_Rekam
        UC_Setor -.->|"<<include>>"| UC_Eval

        UC_Ulang -.->|"<<extend>><br/>(jika bacaan tidak sesuai)"| UC_Setor

        UC_Buka -.->|"<<include>>"| UC_Timer

        UC_SetorLagi -.->|"<<extend>><br/>(setelah waktu habis)"| UC_Setor


        %% DASHBOARD
        UC_XP -.->|"<<extend>>"| UC_Dash
        UC_Prog -.->|"<<extend>>"| UC_Dash

    end


    %% =========================
    %% ACTOR RELATION
    %% =========================

    User --- UC_Dash
    User --- UC_Atur
    User --- UC_Buka
    User --- UC_Ulang
    User --- UC_SetorLagi


